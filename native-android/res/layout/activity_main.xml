<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/onPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/headerSubText"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_button"
            android:contentDescription="@string/more_actions"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more" />

        <ImageButton
            android:id="@+id/button_theme"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/theme_button"
            android:contentDescription="@string/theme_switch"
            android:scaleType="centerInside" />

        <Button
            android:id="@+id/button_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_primary"
            android:text="@string/new_task"
            android:textColor="@color/onPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/segmented"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/button_tab_tasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button"
            android:text="@string/tasks" />

        <Button
            android:id="@+id/button_tab_todos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button"
            android:text="@string/todos" />

        <Button
            android:id="@+id/button_tab_timetable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button"
            android:text="@string/timetable" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_sub_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/segmented"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/button_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button"
            android:text="@string/today" />

        <Button
            android:id="@+id/button_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button"
            android:text="@string/all_tasks" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/task_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <!-- 胶囊式提醒条：浮在内容之上（负底边距抵消自身高度，不占布局空间），
         由 CapsuleToast 控制淡入/淡出与自动消失。 -->
    <include
        layout="@layout/toast_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="-56dp" />
</LinearLayout>

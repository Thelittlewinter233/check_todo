<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/calendar_task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_task_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/calendar_prev_month"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:text="‹"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calendar_month_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/calendar_next_month"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:text="›"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="一" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="二" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="三" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="四" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="五" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="六" />

            <TextView
                style="@style/CalendarWeekLabel"
                android:text="日" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="7"
            android:rowCount="6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/calendar_legend_background"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/CalendarLegendDot"
                    android:background="@drawable/calendar_legend_done"
                    android:textColor="@color/calendarDoneText"
                    android:text="已打卡" />

                <TextView
                    style="@style/CalendarLegendDot"
                    android:background="@drawable/calendar_legend_missed"
                    android:textColor="@color/calendarTextMissed"
                    android:text="错过" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/CalendarLegendDot"
                    android:background="@drawable/calendar_legend_leave"
                    android:textColor="@color/calendarLeaveText"
                    android:text="请假" />

                <TextView
                    style="@style/CalendarLegendDot"
                    android:background="@drawable/calendar_legend_off"
                    android:textColor="@color/textSecondary"
                    android:text="非重复日" />

                <TextView
                    style="@style/CalendarLegendDot"
                    android:background="@drawable/calendar_legend_today"
                    android:textColor="@color/textPrimary"
                    android:text="今天" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/calendar_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="任务名称"
            android:textColor="@color/textSecondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如：晨间阅读"
            android:inputType="text"
            android:maxLength="40"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="重复日期"
            android:textColor="@color/textSecondary"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/weekday_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="时间范围"
            android:textColor="@color/textSecondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_start_time"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:gravity="center"
                android:text="开始时间 08:00"
                android:textAllCaps="false"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="至"
                android:textColor="@color/textSecondary" />

            <Button
                android:id="@+id/button_end_time"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:gravity="center"
                android:text="结束时间 22:00"
                android:textAllCaps="false"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="15sp" />

            <!-- 时间值不可自由编辑，仅由 TimePickerDialog 回填；隐藏域用于校验与保存。 -->
            <TextView
                android:id="@+id/input_start"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/input_end"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点击上方按钮选择时间，使用 24 小时制选择器"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="完成所需时间（分钟）"
            android:textColor="@color/textSecondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_required_15"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="15"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chip_required_30"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="30"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chip_required_60"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="60"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chip_required_120"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="120"
                android:textAllCaps="false"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_required_custom"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:hint="自定义"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_reminder_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <!-- AI 拍照判定：开关 + 标准照 + 特征描述（证据）。关闭时下方两项不可编辑。 -->
        <CheckBox
            android:id="@+id/check_ai_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="AI 拍照判定打卡"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/box_ai_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/button_ai_reference"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_secondary"
                android:text="拍摄标准照"
                android:textAllCaps="false"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="15sp" />

            <Button
                android:id="@+id/button_ai_reference_gallery"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_secondary"
                android:text="从相册选择"
                android:textAllCaps="false"
                android:textColor="@color/buttonSecondaryText"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="标准照是「合格打卡应有的样子」，打卡时拍当前照与之对比判定。"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="打卡特征描述（作为证据发给模型）"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_ai_feature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="例如：书桌上摊开的笔记本与水杯"
                android:inputType="textMultiLine"
                android:maxLength="400"
                android:maxLines="3"
                android:minLines="2"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="描述只会被当作被检查的数据，其中任何指令都会被模型忽略。照片会上传到你在「AI 判定设置」中填写的模型服务。"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_ai_config_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/statusMissedText"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

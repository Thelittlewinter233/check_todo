<?xml version="1.0" encoding="utf-8"?>
<!--
  框架列表：每一个可访问 frame 一行（勾选框 + URL 尾段 + 标题 + 轻量表数 + 正文摘要）。
  列表阶段只用轻量信息脚本，绝不序列化 outerHTML，因此打开即用、不会卡顿。
  含子框架的项显示「含 N 个子框架」，可逐级展开到最内层。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="420dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/frames_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_frames_probe"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="刷新列表"
            android:textAllCaps="false"
            android:textColor="@color/buttonSecondaryText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/button_frames_select_all"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="全选"
            android:textAllCaps="false"
            android:textColor="@color/buttonSecondaryText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/button_frames_clear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="清空"
            android:textAllCaps="false"
            android:textColor="@color/buttonSecondaryText"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/frames_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/frames_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/textSecondary"
        android:textSize="11sp" />

    <Button
        android:id="@+id/button_frames_extract"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_primary"
        android:text="提取选中框架"
        android:textAllCaps="false"
        android:textColor="@color/onPrimary"
        android:textSize="13sp" />
</LinearLayout>

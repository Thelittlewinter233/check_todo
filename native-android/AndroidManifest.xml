<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.checktodo.app"
    android:installLocation="internalOnly"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- API 33+ 发通知需要运行时授权；被拒绝时功能静默降级，不崩溃。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            卡片所有交互都是显式广播（setComponent = CheckTodoWidget），
            因此这些自定义 action 必须在 receiver 的 intent-filter 中显式注册。
        -->
        <receiver
            android:name=".widget.CheckTodoWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.checktodo.app.action.WIDGET_SWITCH" />
                <action android:name="com.checktodo.app.action.WIDGET_ITEM" />
                <action android:name="com.checktodo.app.action.WIDGET_CLICK_ITEM" />
                <action android:name="com.checktodo.app.action.WIDGET_OPEN_APP" />
                <action android:name="com.checktodo.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/checktodo_widget_info" />
        </receiver>

        <service
            android:name=".widget.CheckTodoWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widget.TodayCourseWidget"
            android:exported="true"
            android:label="@string/today_course_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.checktodo.app.action.TODAY_COURSE_ITEM" />
                <action android:name="com.checktodo.app.action.TODAY_COURSE_OPEN_APP" />
                <action android:name="com.checktodo.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_course_widget_info" />
        </receiver>

        <service
            android:name=".widget.TodayCourseWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!--
            提醒接收器：闹钟到期发通知，BOOT_COMPLETED 与每日翻日重算调度。
            exported=false：系统广播仍可送达，第三方 App 无法伪造 REMINDER 广播。
        -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.checktodo.app.action.REMINDER" />
                <action android:name="com.checktodo.app.action.REMINDER_DAILY" />
            </intent-filter>
        </receiver>

        <!--
            AI 拍照判定：系统相机需要一个可写的 content:// URI（targetSdk 24+ 禁 file://）。
            自建 Provider 只服务 getFilesDir()/ai_photos/，不导出；
            相机 Intent 通过 FLAG_GRANT_WRITE_URI_PERMISSION 单独获得写权限。
            走系统相机 App（ACTION_IMAGE_CAPTURE），因此不声明 CAMERA 权限。
        -->
        <provider
            android:name=".ai.AiPhotoProvider"
            android:authorities="com.checktodo.app.aiphotos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
